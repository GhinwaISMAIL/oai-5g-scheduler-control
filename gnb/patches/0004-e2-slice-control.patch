+/* A slice control message is translated into the slice commands of the downlink scheduler
+ * (see nr_dl_ctrl_slice_sm.h) and sent to the local control endpoint, the same one that
+ * bin/sched-ctl.py and the MAC service model reach.  The message is checked completely
+ * before the first command is sent. */
+
+static int send_to_endpoint(const char* text, char* reply, size_t size, void* ctx)
+{
+  (void)ctx;
+  return nr_ctrl_e2_send(text, reply, size);
+}
+
+static void run_plan(const char* what, const nr_ctrl_sm_plan_t* plan)
+{
+  char reply[256];
+  int refused = -1;
+  int done = nr_ctrl_sm_apply(plan, send_to_endpoint, NULL, reply, sizeof(reply), &refused);
+  for (size_t n = strlen(reply); n > 0 && (reply[n - 1] == '\n' || reply[n - 1] == '\r'); n--)
+    reply[n - 1] = '\0';
+  if (refused >= 0)
+    printf("[E2 Agent]: SLICE CONTROL %s: \"%s\" refused: %s (%d of %d commands applied)\n",
+           what, plan->text[refused], reply[0] ? reply : "no answer from the scheduler control endpoint", done, plan->n);
+  else
+    printf("[E2 Agent]: SLICE CONTROL %s applied (%d commands)\n", what, done);
+}
+
+static char* copy_name(const char* s, uint32_t* len)
+{
+  *len = (uint32_t)strlen(s);
+  char* p = malloc(*len);
+  assert(p != NULL && "memory exhausted");
+  memcpy(p, s, *len);
+  return p;
+}
